# ====================================================================
# DocuMind Backend Environment Configuration
# ====================================================================

# Environment ("development" or "production")
ENVIRONMENT=development
PROJECT_NAME="DocuMind API"
VERSION=1.0.0
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Security & JWT (Must be 32+ characters in production)
SECRET_KEY=documind_local_development_jwt_secret_key_987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMITING_ENABLED=true

# CORS: Comma-separated domains or JSON array
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database: PostgreSQL with pgvector or SQLite for local dev
DATABASE_URL=sqlite:///./documind.db

# AI & LLM Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
AI_QUOTA_PER_USER_DAILY=200

# RAG Engine Parameters
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.20
RAG_ENABLE_HYBRID=true
RAG_ENABLE_RERANKING=true

# Storage: "local" or "s3"
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage/uploads
MAX_FILE_SIZE_MB=50

# S3 / MinIO / Cloudflare R2 (Required when STORAGE_PROVIDER=s3)
S3_BUCKET_NAME=documind-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=
