# ====================================================================
# DocuMind Production Environment Template
# ====================================================================

# 1. APPLICATION ENVIRONMENT
ENVIRONMENT=production
PROJECT_NAME="DocuMind AI"
API_V1_STR=/api/v1

# 2. SECURITY (Generate a random 32+ character key for production)
SECRET_KEY=replace_with_a_secure_random_production_secret_key_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. MANAGED DATABASE (Supabase or Neon PostgreSQL with pgvector)
# Example: postgresql://postgres.abcdefghijk:YourPassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=your_managed_postgresql_connection_string_here

# 4. AI & LLM PROVIDER
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 5. OBJECT STORAGE (Cloudflare R2 or AWS S3)
STORAGE_PROVIDER=local
# If using AWS S3 / Cloudflare R2:
# STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=documind-prod-documents
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your_access_key_id
# S3_SECRET_KEY=your_secret_access_key
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# 6. CORS ORIGINS (Add your production frontend domain)
BACKEND_CORS_ORIGINS=["https://your-frontend-app.vercel.app","http://localhost:3000"]

# 7. FRONTEND PUBLIC API URL (Set this in Vercel)
# NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com/api/v1
