# ====================================================================
# DocuMind Production Environment Configuration Template
# ====================================================================

# 1. APPLICATION ENVIRONMENT
ENVIRONMENT=production
PROJECT_NAME="DocuMind AI"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# 2. SECURITY & JWT (Required: Generate a 32+ char random string via `openssl rand -hex 32`)
SECRET_KEY=replace_with_a_secure_random_production_secret_key_32_chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMITING_ENABLED=true

# 3. MANAGED DATABASE (Supabase, Neon, AWS RDS, or Managed PostgreSQL 16 with pgvector)
# Example: postgresql://postgres.abcdefghijk:YourPassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://username:password@db-host:5432/documind

# 4. PRIMARY AI & EMBEDDINGS PROVIDER (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536
AI_QUOTA_PER_USER_DAILY=200

# 5. OPTIONAL ALTERNATIVE PROVIDER (OpenAI Compatibility)
# To use OpenAI instead of Gemini, set AI_PROVIDER=openai and EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# 6. RAG ENGINE PARAMETERS
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.20
RAG_ENABLE_HYBRID=true
RAG_ENABLE_RERANKING=true

# 7. PERSISTENT CLOUD OBJECT STORAGE
# Option A: Supabase Storage (Recommended for 100% $0/month free tier)
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=documind-documents
MAX_FILE_SIZE_MB=50

# Option B: AWS S3 or Cloudflare R2 (Set STORAGE_PROVIDER=s3 if using S3/R2)
# STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=documind-production-documents
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your_s3_or_r2_access_key_id
# S3_SECRET_KEY=your_s3_or_r2_secret_access_key
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# 8. CORS ORIGINS (Set your production Vercel frontend URL)
BACKEND_CORS_ORIGINS=["https://documind.vercel.app","https://yourdomain.com"]

# 9. FRONTEND ENVIRONMENT VARIABLE (Set in Vercel project settings)
# NEXT_PUBLIC_API_URL=https://documind-api.onrender.com/api/v1

