# ----------------------------------------------------
# DocuMind Local Development Configuration
# ----------------------------------------------------

# Environment
ENVIRONMENT=development
PROJECT_NAME="DocuMind AI"
API_V1_STR=/api/v1

# Security & JWT
SECRET_KEY=documind_local_development_jwt_secret_key_987654321
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (Zero-dependency SQLite for local dev or PostgreSQL with Docker)
DATABASE_URL=sqlite:///./documind.db

# Storage (Local disk storage)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage/uploads

# AI / Embeddings (Uses built-in semantic engine by default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
