# ----------------------------------------------------
# DocuMind Environment Configuration
# ----------------------------------------------------

# Environment: development | staging | production
ENVIRONMENT=development

# Backend Settings
PROJECT_NAME="DocuMind API"
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_jwt_secret_key_minimum_32_chars_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL + pgvector)
# Local Docker or Managed Cloud PostgreSQL (e.g. Supabase, Neon, AWS RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/documind

# AI & LLM Services (OpenAI or Compatible API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Cloud Object Storage (S3 / MinIO / Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage/uploads
S3_BUCKET_NAME=documind-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_ENDPOINT_URL=

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
